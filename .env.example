# LUMINA environment. Copy to .env and fill in. Never commit .env.
# Keys are read ONLY by the agent service. The gateway needs only AGENT_URL and its own port.

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lumina?retryWrites=true&w=majority
MONGODB_DB=lumina
# atlas-vector-search (default) | mongo-cosine-scan (local docker mongod fallback, dev only; /health reports it)
VECTOR_BACKEND=atlas-vector-search

# ── LLM (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# ── Embeddings + images (OpenAI) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small      # 1536 dims, fixed by the data model
IMAGE_MODEL=gpt-image-1
IMAGE_DAILY_CAP=10                          # per X-User-Id, enforced in the agent service -> 429
IMAGE_COST_USD=0.04                         # declared per-image cost logged on each ready artifact (1024x1024 standard)
DRY_RUN=false                               # true returns a placeholder image with costUsd 0

# ── Search ───────────────────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily                      # tavily | serpapi, swappable with no code change
TAVILY_API_KEY=tvly-...
SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=21600              # 6 h

# ── Loop caps ────────────────────────────────────────────────────────────────
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90

# ── Deep Search (depth=deep): a separate budget from the loop caps above ─────
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=5
DEEP_RESULTS_PER_SUBQ=3                     # pages fetched per sub-question; drives the >=2x source ratio
DEEP_DAILY_CAP=5                            # per X-User-Id, enforced in the agent service -> 429 {error, resetsAt}
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240

# ── Retrieval config (declared, not hard-coded) ──────────────────────────────
RAG_TOP_K=8
RAG_MIN_SCORE=0.08
MEMORY_RECALL_LIMIT=10
THREAD_HISTORY_TURNS=6                      # prior turns replayed so a follow-up has context
JOB_STALE_CLAIM_SEC=300                     # a job claimed longer ago than this is swept back to pending

# ── Services ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=8787
AGENT_PORT=8000
AGENT_URL=http://localhost:8000             # gateway -> agent; on Fly, the private .internal URL
CORS_ORIGIN=http://localhost:3000                  # comma-separated allow-list; every front end that calls this gateway
RATE_LIMIT_PER_MINUTE=60

# ── UI (Next.js reads only NEXT_PUBLIC_* vars; never put a key here) ─────────
NEXT_PUBLIC_API_URL=http://localhost:8787
