# secrets
.env
.env.*
!.env.example

# dependencies
node_modules/

# builds
web/.next/
web/out/
web/dist/
backend/**/dist/
packages/**/dist/
*.tsbuildinfo

# generated by runs, never committed
runs/*
!runs/.gitkeep
reports/*
!reports/.gitkeep

# local mongo data (docker compose)
.data/

# editor / os
.DS_Store
.vscode/
.idea/
*.log
web/public/report.json

# Pre-migration copies of the hand-rolled provided folders, kept locally for
# comparison only. Never committed: a duplicate of packages/contract in the
# repo would look like the provided contract was edited.
.pre-official-backup/

# Staged build of the PROVIDED UI (see build-provided-ui.mjs). Build output,
# regenerate it rather than commit it.
provided-ui-dist/
